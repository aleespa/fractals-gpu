<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FractalExplorer.Controls.GradientEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="40">
    <Grid x:Name="Host" SizeChanged="Host_SizeChanged">
        <Rectangle x:Name="Bar" Height="24" RadiusX="6" RadiusY="6" VerticalAlignment="Center"
                   Stroke="#33FFFFFF" StrokeThickness="1" />
        <Canvas x:Name="HandleCanvas" Background="Transparent"
                PointerPressed="Canvas_PointerPressed"
                PointerMoved="Canvas_PointerMoved"
                PointerReleased="Canvas_PointerReleased"
                PointerCanceled="Canvas_PointerCanceled"
                PointerCaptureLost="Canvas_PointerCaptureLost" />
    </Grid>
</UserControl>
