<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FractalExplorer</RootNamespace>
    <AssemblyName>FractalExplorer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <Version>0.2.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FractalExplorer.Core\FractalExplorer.Core.csproj" />
    <ProjectReference Include="..\FractalCore\FractalCore.vcxproj" ReferenceOutputAssembly="false" Condition="'$(MSBuildRuntimeType)' == 'Full'" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\x64\$(Configuration)\FractalCore.dll" Link="FractalCore.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The FractalCore.vcxproj reference is build-ordering only (no assembly). WinUI's targets force
       FindInvalidProjectReferences=true, which would warn (MSB3851) that the native DLL targets a newer
       Windows SDK; drop native projects from the list that check inspects. -->
  <Target Name="ExcludeNativeProjectsFromPlatformCheck" AfterTargets="GetReferenceTargetPlatformMonikers">
    <ItemGroup>
      <_ProjectReferenceTargetPlatformMonikers Remove="@(_ProjectReferenceTargetPlatformMonikers)"
          Condition="'%(_ProjectReferenceTargetPlatformMonikers.MSBuildSourceProjectFile)' != '' and $([System.String]::Copy('%(_ProjectReferenceTargetPlatformMonikers.MSBuildSourceProjectFile)').EndsWith('.vcxproj'))" />
    </ItemGroup>
  </Target>
</Project>
