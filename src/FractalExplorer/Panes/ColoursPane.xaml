<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FractalExplorer.Panes.ColoursPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FractalExplorer.Controls">

    <StackPanel Spacing="8" Padding="16,12,16,16">
        <TextBlock Text="Gradient" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <controls:GradientEditor x:Name="PaletteEditor" />
        <TextBlock Text="Click the bar to add a stop · drag to move · click a stop to recolour · right-click to delete"
                   TextWrapping="Wrap" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />

        <TextBlock Text="Presets" Margin="0,16,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <TextBlock Text="Coming soon" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
    </StackPanel>
</UserControl>
