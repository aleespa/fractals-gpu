<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FractalExplorer.Panes.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Padding="32" Spacing="8">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />

            <TextBlock Text="Saving" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Save folder" />
                        <TextBlock x:Name="FolderText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.7" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Change…" Click="ChangeFolder_Click" />
                            <Button Content="Open folder" Click="OpenFolder_Click" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <ComboBox x:Name="SizeCombo" Header="Default size" MinWidth="200"
                                  SelectionChanged="SizeCombo_SelectionChanged">
                            <ComboBoxItem Content="4K (3840 × 2160)" />
                            <ComboBoxItem Content="8K (7680 × 4320)" />
                            <ComboBoxItem Content="Custom" />
                        </ComboBox>
                        <StackPanel x:Name="CustomSizePanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <NumberBox x:Name="WidthBox" Header="Width" Width="120" ValidationMode="Disabled"
                                       SpinButtonPlacementMode="Hidden" ValueChanged="SizeBox_ValueChanged" />
                            <NumberBox x:Name="HeightBox" Header="Height" Width="120" ValidationMode="Disabled"
                                       SpinButtonPlacementMode="Hidden" ValueChanged="SizeBox_ValueChanged" />
                        </StackPanel>
                        <TextBlock x:Name="SizeError" Visibility="Collapsed" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="Width and height must be between 16 and 16384." />
                    </StackPanel>

                    <ComboBox x:Name="SmoothCombo" Header="Default smoothing" MinWidth="200"
                              SelectionChanged="SmoothCombo_SelectionChanged">
                        <ComboBoxItem Content="Off" />
                        <ComboBoxItem Content="4×" />
                        <ComboBoxItem Content="16×" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <RadioButtons x:Name="ThemeRadios" Header="Theme" SelectionChanged="ThemeRadios_SelectionChanged">
                    <x:String>Use system setting</x:String>
                    <x:String>Light</x:String>
                    <x:String>Dark</x:String>
                </RadioButtons>
            </Border>

            <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="VersionText" />
                    <TextBlock Text="GPU-rendered Mandelbrot and Julia sets." Opacity="0.7" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
