<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FractalExplorer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FractalExplorer.Controls"
    Title="Fractal Explorer">

    <Grid x:Name="RootGrid">
        <!-- Full-window fractal view: receives pan (drag) and zoom (wheel). -->
        <Grid x:Name="ViewArea"
              Background="Transparent"
              SizeChanged="ViewArea_SizeChanged"
              PointerPressed="ViewArea_PointerPressed"
              PointerMoved="ViewArea_PointerMoved"
              PointerReleased="ViewArea_PointerReleased"
              PointerCanceled="ViewArea_PointerReleased"
              PointerCaptureLost="ViewArea_PointerCaptureLost"
              PointerWheelChanged="ViewArea_PointerWheelChanged">
            <Image x:Name="FractalImage" Stretch="Fill"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="PreviewXform" />
                </Image.RenderTransform>
            </Image>
        </Grid>

        <!-- Controls overlay on the left. -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Stretch"
                Width="300" Margin="16"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="#33FFFFFF"
                Background="#B3181818">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ControlsPanel" Spacing="12" Padding="20">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Fractal Explorer" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Drag to pan • Scroll to zoom" Opacity="0.7"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>

                    <ComboBox x:Name="TypeCombo" Header="Fractal Type" HorizontalAlignment="Stretch"
                              SelectionChanged="TypeCombo_SelectionChanged">
                        <ComboBoxItem Content="Mandelbrot Set" />
                        <ComboBoxItem Content="Julia Set" />
                    </ComboBox>

                    <StackPanel>
                        <TextBlock x:Name="IterLabel" Text="Max Iterations: 400" />
                        <Slider x:Name="IterSlider" Minimum="50" Maximum="3000" StepFrequency="10"
                                SmallChange="10" LargeChange="100" Value="400"
                                ValueChanged="IterSlider_ValueChanged" />
                    </StackPanel>

                    <StackPanel x:Name="JuliaControls" Visibility="Collapsed">
                        <TextBlock x:Name="CxLabel" Text="Cx: -0.400" />
                        <Slider x:Name="CxSlider" Minimum="-2" Maximum="2" StepFrequency="0.001"
                                SmallChange="0.001" LargeChange="0.1" Value="-0.4"
                                IsThumbToolTipEnabled="False"
                                ValueChanged="JuliaSlider_ValueChanged" />
                        <TextBlock x:Name="CyLabel" Text="Cy: 0.600" />
                        <Slider x:Name="CySlider" Minimum="-2" Maximum="2" StepFrequency="0.001"
                                SmallChange="0.001" LargeChange="0.1" Value="0.6"
                                IsThumbToolTipEnabled="False"
                                ValueChanged="JuliaSlider_ValueChanged" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Colour Palette" />
                        <controls:GradientEditor x:Name="PaletteEditor" />
                    </StackPanel>

                    <Grid x:Name="StatsGrid" ColumnSpacing="8" RowSpacing="2" Opacity="0.85">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="X:" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StatX" FontFamily="Consolas" />
                        <TextBlock Grid.Row="1" Text="Y:" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StatY" FontFamily="Consolas" />
                        <TextBlock Grid.Row="2" Text="Zoom:" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="StatZoom" FontFamily="Consolas" />
                    </Grid>

                    <Button x:Name="ResetButton" Content="Reset View" HorizontalAlignment="Stretch"
                            Click="ResetButton_Click" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <InfoBar x:Name="ErrorBar" Severity="Error" Title="Render failed" IsOpen="False"
                 IsClosable="True" VerticalAlignment="Top" HorizontalAlignment="Center"
                 MaxWidth="640" Margin="332,16,16,0" />

        <ProgressRing x:Name="Busy" IsActive="False" Width="28" Height="28"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" />
    </Grid>
</Window>
