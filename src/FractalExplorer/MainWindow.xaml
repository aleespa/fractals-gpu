<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FractalExplorer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Fractal Explorer">

    <NavigationView x:Name="NavView"
                    PaneDisplayMode="Left"
                    OpenPaneLength="300"
                    IsPaneOpen="True"
                    IsSettingsVisible="True"
                    IsBackButtonVisible="Collapsed"
                    PaneTitle="Fractal Explorer"
                    ItemInvoked="NavView_ItemInvoked"
                    SelectionChanged="NavView_SelectionChanged"
                    PaneOpening="NavView_PaneOpening"
                    PaneClosing="NavView_PaneClosing"
                    Loaded="NavView_Loaded">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="FractalNavItem" Content="Fractal">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8B9;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="ColoursNavItem" Content="Colours">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE790;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <!-- Side panel: content of the selected rail item. Hidden while the pane is collapsed to the rail. -->
        <NavigationView.PaneFooter>
            <Grid x:Name="SidePanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Rectangle Height="1" Margin="12,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="PanelContent" HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Top" IsTabStop="False" />
                </ScrollViewer>
            </Grid>
        </NavigationView.PaneFooter>

        <Grid x:Name="ContentRoot">
            <!-- Fractal canvas: receives pan (drag) and zoom (wheel). -->
            <Grid x:Name="CanvasHost"
                  Background="Transparent"
                  SizeChanged="CanvasHost_SizeChanged"
                  PointerPressed="CanvasHost_PointerPressed"
                  PointerMoved="CanvasHost_PointerMoved"
                  PointerReleased="CanvasHost_PointerReleased"
                  PointerCanceled="CanvasHost_PointerReleased"
                  PointerCaptureLost="CanvasHost_PointerCaptureLost"
                  PointerWheelChanged="CanvasHost_PointerWheelChanged">
                <Image x:Name="FractalImage" Stretch="Fill"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Image.RenderTransform>
                        <CompositeTransform x:Name="PreviewXform" />
                    </Image.RenderTransform>
                </Image>

                <ProgressRing x:Name="Busy" IsActive="False" Width="24" Height="24" IsHitTestVisible="False"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16" />

                <!-- Coordinates overlay (non-interactive so it never blocks pan/zoom). -->
                <Border x:Name="CoordsOverlay" IsHitTestVisible="False"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16"
                        CornerRadius="6" Padding="10,6" Background="#99000000">
                    <TextBlock x:Name="CoordsText" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                               Foreground="White" />
                </Border>
            </Grid>

            <!-- Top-right of the canvas: Save (quick save) with a "Save as..." flyout. -->
            <Grid x:Name="SaveHost" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" SizeChanged="SaveHost_SizeChanged">
                <SplitButton x:Name="SaveButton" Click="SaveButton_Click" AutomationProperties.Name="Save">
                    <SplitButton.Resources>
                        <!-- Accent look (WinUI has no accent SplitButton style; AccentButtonStyle targets Button):
                             map the normal states onto the accent brushes the template uses when checked. -->
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Default">
                                    <StaticResource x:Key="SplitButtonBackground" ResourceKey="AccentFillColorDefaultBrush" />
                                    <StaticResource x:Key="SplitButtonBackgroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                                    <StaticResource x:Key="SplitButtonBackgroundPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                                    <StaticResource x:Key="SplitButtonBackgroundDisabled" ResourceKey="AccentFillColorDisabledBrush" />
                                    <StaticResource x:Key="SplitButtonForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundPressed" ResourceKey="TextOnAccentFillColorSecondaryBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundDisabled" ResourceKey="TextOnAccentFillColorDisabledBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrush" ResourceKey="AccentControlElevationBorderBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrushPointerOver" ResourceKey="AccentControlElevationBorderBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrushPressed" ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrushDisabled" ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrushDivider" ResourceKey="ControlStrokeColorOnAccentTertiaryBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <StaticResource x:Key="SplitButtonBackground" ResourceKey="AccentFillColorDefaultBrush" />
                                    <StaticResource x:Key="SplitButtonBackgroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                                    <StaticResource x:Key="SplitButtonBackgroundPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                                    <StaticResource x:Key="SplitButtonBackgroundDisabled" ResourceKey="AccentFillColorDisabledBrush" />
                                    <StaticResource x:Key="SplitButtonForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundPressed" ResourceKey="TextOnAccentFillColorSecondaryBrush" />
                                    <StaticResource x:Key="SplitButtonForegroundDisabled" ResourceKey="TextOnAccentFillColorDisabledBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrush" ResourceKey="AccentControlElevationBorderBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrushPointerOver" ResourceKey="AccentControlElevationBorderBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrushPressed" ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrushDisabled" ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="SplitButtonBorderBrushDivider" ResourceKey="ControlStrokeColorOnAccentTertiaryBrush" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </SplitButton.Resources>
                    <SplitButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="QuickSaveAccelerator_Invoked" />
                        <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="SaveAsAccelerator_Invoked" />
                    </SplitButton.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="16" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Save as…" Click="SaveAsItem_Click"
                                            KeyboardAcceleratorTextOverride="Ctrl+Shift+S" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </Grid>

            <!-- Settings page; covers the canvas while Settings is selected. -->
            <Grid x:Name="SettingsHost" Visibility="Collapsed"
                  Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />

            <StackPanel x:Name="TopBars" VerticalAlignment="Top" HorizontalAlignment="Stretch" MaxWidth="640"
                        Margin="16,16,16,0" Spacing="8">
                <!-- Save progress strip (visible only while a save runs). -->
                <Border x:Name="SaveStrip" Visibility="Collapsed" Padding="12,8"
                        CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock x:Name="SaveProgressText" TextTrimming="CharacterEllipsis" />
                            <ProgressBar x:Name="SaveProgress" Minimum="0" Maximum="100" Value="0" />
                        </StackPanel>
                        <Button x:Name="CancelSaveButton" Grid.Column="1" Content="Cancel" VerticalAlignment="Center" Click="CancelSave_Click" />
                    </Grid>
                </Border>
                <InfoBar x:Name="ErrorBar" Severity="Error" Title="Render failed" IsOpen="False" IsClosable="True" />
                <InfoBar x:Name="InfoMessageBar" Severity="Informational" IsOpen="False" IsClosable="True" />
                <InfoBar x:Name="SuccessBar" Severity="Success" IsOpen="False" IsClosable="True">
                    <InfoBar.ActionButton>
                        <HyperlinkButton x:Name="OpenFolderButton" Content="Open folder" Click="OpenFolderButton_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>
        </Grid>
    </NavigationView>
</Window>
